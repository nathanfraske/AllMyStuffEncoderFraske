+#[test]
+fn wrong_or_foreign_authority_cannot_consume_known_flow_and_close_ack_outcomes_do_not_restore_it() {
+    run_case(|state| async move {
+        let (client, _rx) = registered(&state.clients);
+        let _owner = EventsOwner::new(&state.clients, &client);
+        let (bystander, _bystander_rx) = registered(&state.clients);
+        let _bystander_owner = EventsOwner::new(&state.clients, &bystander);
+        let other = installed(&state, &bystander, b"untouched");
+        let frames = admission();
+        for mode in [
+            WriteMode::PrefixError,
+            WriteMode::FlushError,
+            WriteMode::Sent,
+        ] {
+            let capability = installed(&state, &client, b"one-close");
+            for (id, presented) in [
+                (client.id, "not-a-client-capability"),
+                (client.id, bystander.capability()),
+                (bystander.id, client.capability()),
+            ] {
+                let reply = close_reply(&state, &frames, id, presented, &capability).await;
+                assert!(has_error(reply, &frames, "invalid local client authority"));
+                assert!(contains(&client, &capability));
+            }
+            let reply = close_reply(
+                &state,
+                &frames,
+                bystander.id,
+                bystander.capability(),
+                &capability,
+            )
+            .await;
+            assert!(has_error(reply, &frames, UNKNOWN_FLOW));
+            assert!(contains(&client, &capability));
+
+            let reply =
+                close_reply(&state, &frames, client.id, client.capability(), &capability).await;
+            // No network is joined. This is a consumed-F close refusal, not a
+            // successful native close: removal precedes the network lookup.
+            assert!(!contains(&client, &capability));
+            let line = encoded_reply(reply, &frames);
+            assert!(line_has_error(
+                &line,
+                "unknown network: owner-regression-net"
+            ));
+            let cancel = ConnectionCancel::owned_by(&state.clients, &client);
+            let (mut writer, accepted) = CountWriter::new(mode);
+            let wrote = write_admitted_line(&mut writer, &cancel, line)
+                .await
+                .expect("fixture close refusal is encodable");
+            assert!(accepted.load(Ordering::SeqCst) > 0);
+            let expected = if matches!(mode, WriteMode::Sent) {
+                Wrote::Sent
+            } else {
+                Wrote::Ended
+            };
+            assert!(wrote == expected);
+            // This second exact close observes the consumed token. It is an
+            // assertion of refusal, not an automatic recovery/reopen attempt.
+            let repeated =
+                close_reply(&state, &frames, client.id, client.capability(), &capability).await;
+            assert!(has_error(repeated, &frames, UNKNOWN_FLOW));
+            assert!(contains(&bystander, &other));
+            assert!(state.clients.is_current_owner(&bystander));
+        }
+    });
+}
