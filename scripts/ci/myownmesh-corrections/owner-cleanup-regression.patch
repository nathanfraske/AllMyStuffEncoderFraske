+#[test]
+fn sent_open_with_revoked_owner_rolls_back_exact_flow_and_spares_successor() {
+    run_case(|state| async move {
+        let (client, _rx) = registered(&state.clients);
+        let old_owner = EventsOwner::new(&state.clients, &client);
+        let capability = installed(&state, &client, b"stale-open");
+        let mut handoff = HandoffGuard::new(ProvisionalHandoff::RealtimeFlow {
+            client: client.clone(),
+            capability: capability.clone(),
+        });
+        // Hold the removed record alive, as an in-progress normal cleanup can.
+        // An unconditional Sent commit would strand F until those clones drop.
+        let removed = state
+            .clients
+            .unregister_exact(&client)
+            .expect("remove exact owner");
+        assert!(contains(&client, &capability));
+        let (successor, _successor_rx) = registered(&state.clients);
+        let _successor_owner = EventsOwner::new(&state.clients, &successor);
+        let successor_capability = installed(&state, &successor, b"new-owner");
+        handoff.settle(&state, true).await;
+        assert!(!contains(&client, &capability));
+        drop(old_owner);
+        assert!(contains(&successor, &successor_capability));
+        assert!(state.clients.is_current_owner(&successor));
+        drop(removed);
+    });
+}
