+#[test]
+fn authenticated_owner_revocation_ends_partial_reply_but_not_another_owner() {
+    run_case(|state| async move {
+        let (client, _rx) = registered(&state.clients);
+        let owner = EventsOwner::new(&state.clients, &client);
+        let (bystander, _bystander_rx) = registered(&state.clients);
+        let _bystander_owner = EventsOwner::new(&state.clients, &bystander);
+        let capability = installed(&state, &client, b"owner-cancelled");
+        let other = installed(&state, &bystander, b"not-cancelled");
+        let cancel =
+            ConnectionCancel::authenticated(&state.clients, client.id, client.capability());
+        let other_cancel =
+            ConnectionCancel::authenticated(&state.clients, bystander.id, bystander.capability());
+        let frames = admission();
+        let (mut writer, accepted) = CountWriter::new(WriteMode::PrefixPending);
+        let mut writing = Box::pin(write_variable(
+            &mut writer,
+            &frames,
+            &cancel,
+            open_reply(&frames, &capability),
+        ));
+        assert_pending(writing.as_mut());
+        assert!(accepted.load(Ordering::SeqCst) == 8);
+        drop(owner);
+        assert!(writing.await.expect("owner cancellation ends the reply") == Wrote::Ended);
+        assert!(!contains(&client, &capability));
+        assert_pending(Box::pin(other_cancel.cancelled()).as_mut());
+        assert!(contains(&bystander, &other));
+    });
+}
