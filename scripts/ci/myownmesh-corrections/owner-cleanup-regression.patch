+#[test]
+fn cancellation_after_partial_open_ack_withdraws_only_the_provisional_flow() {
+    run_case(|state| async move {
+        let (client, _rx) = registered(&state.clients);
+        let _owner = EventsOwner::new(&state.clients, &client);
+        let capability = installed(&state, &client, b"cancelled-open");
+        let keep = installed(&state, &client, b"same-owner-kept");
+        let frames = admission();
+        let (mut writer, accepted) = CountWriter::new(WriteMode::PrefixPending);
+        let mut connection = Box::pin(async {
+            let mut handoff = HandoffGuard::new(ProvisionalHandoff::RealtimeFlow {
+                client: client.clone(),
+                capability: capability.clone(),
+            });
+            let cancel = ConnectionCancel::owned_by(&state.clients, &client);
+            let wrote = write_variable(
+                &mut writer,
+                &frames,
+                &cancel,
+                open_reply(&frames, &capability),
+            )
+            .await;
+            handoff
+                .settle(&state, matches!(wrote, Ok(Wrote::Sent)))
+                .await;
+        });
+        assert_pending(connection.as_mut());
+        assert!(accepted.load(Ordering::SeqCst) == 8);
+        drop(connection);
+        assert!(state.clients.is_current_owner(&client));
+        assert!(!contains(&client, &capability));
+        assert!(contains(&client, &keep));
+    });
+}
