+#[test]
+fn server_sent_without_client_receipt_retains_flow_until_exact_owner_teardown() {
+    run_case(|state| async move {
+        let (client, _rx) = registered(&state.clients);
+        let owner = EventsOwner::new(&state.clients, &client);
+        let capability = installed(&state, &client, b"sent-not-observed");
+        let mut handoff = HandoffGuard::new(ProvisionalHandoff::RealtimeFlow {
+            client: client.clone(),
+            capability: capability.clone(),
+        });
+        let frames = admission();
+        let cancel = ConnectionCancel::owned_by(&state.clients, &client);
+        let (mut writer, accepted) = CountWriter::new(WriteMode::Sent);
+        let wrote = write_variable(
+            &mut writer,
+            &frames,
+            &cancel,
+            open_reply(&frames, &capability),
+        )
+        .await
+        .expect("fixture server accepts and flushes the whole ACK");
+        assert!(wrote == Wrote::Sent && accepted.load(Ordering::SeqCst) > 8);
+        // This writer has no receiving client. Sent alone cannot distinguish
+        // delivered ACK from lost receipt, and must not undo a live owner's F.
+        handoff.settle(&state, true).await;
+        assert!(contains(&client, &capability));
+        drop(owner);
+        assert!(!contains(&client, &capability));
+    });
+}
