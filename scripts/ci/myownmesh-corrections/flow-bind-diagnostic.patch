+    if tracing::enabled!(target: "mesh_first_unit", tracing::Level::DEBUG) {
+        if let Ok(ordinal) = counter.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |count| {
+            if count < 8 {
+                Some(count + 1)
+            } else {
+                None
+            }
+        }) {
+            tracing::debug!(target: "mesh_first_unit", stage, ordinal,
+                connector_ordinal, pump_ordinal, result, bytes, "MESH04_FLOW_BIND");
+        }
+    }
+}
