+static FLOW_BIND_RETIRE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+fn flow_bind_next_ordinal(counter: &std::sync::atomic::AtomicUsize) -> usize {
+    counter
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+            value.checked_add(1)
+        })
+        .map_or(0, |previous| previous + 1)
+}
