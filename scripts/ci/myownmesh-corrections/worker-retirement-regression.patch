+//! Real joined-session retirement must terminate its idle outbound IPC pipes.
+//! This is an exact captured-session/daemon-socket criterion, not a reconnect,
+//! replacement-ACTIVE, media-delivery, decode, relay or application-watcher test.
+
+use super::*;
+use crate::ipc::{ClientHandle, ClientId, ClientRegistry, LeasedList, Lifecycle, RegistryResidue};
+use interprocess::local_socket::{GenericFilePath, GenericNamespaced, ToFsName, ToNsName};
+use myownmesh_core::{
+    ConnectorCallbackPolicy, ConnectorResourceOwnerPort, FiniteResourceProvider, FundedArc,
+    JoinedNetwork, Mesh, MeshConfig, ProcessResourceRoot, ResourceClaim,
+    TransportLabRetirableSession, WebRtcConnectorCapablePolicy, WebRtcConnectorProfile,
+    WebRtcRealtimeCodec, WebRtcRealtimeFlowOpen, WebRtcRealtimeFraming, WebRtcRealtimeProfile,
+    WebRtcRtpKind,
+};
+use std::future::Future;
+use std::task::{Context as TaskContext, Poll, Waker};
+use std::time::Duration;
+use tokio::io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt, BufReader};
+
+type Check<T> = std::result::Result<T, &'static str>;
+type ClientSocket = BufReader<LocalSocketStream>;
+type ConnectionTask = tokio::task::JoinHandle<Result<()>>;
+
+// Existing loopback setup and daemon-test hang bounds. No transition is driven
+// by a sleep, retry or grace interval. A timed-out observation is retained and
+// asserted only after the independent controls and exhaustive owned cleanup.
+const CONNECT_BOUND: Duration = Duration::from_secs(15);
+const STEP_BOUND: Duration = Duration::from_secs(10);
+const NETWORK: &str = "retirement-near";
+const IDLE_LABEL: &[u8] = b"retirement-idle";
+const FRAME_LABEL: &[u8] = b"retirement-frame";
+// The existing native/paired fixture's exact first 119-byte H264 access unit.
+// It is sent only after retirement; no RTP or remote receipt is claimed here.
+const VIDEO: &[u8] = &[
+    0x00, 0x00, 0x00, 0x01, 0x67, 0x42, 0xd0, 0x0b, 0x8c, 0x68, 0x42, 0x48, 0x07, 0x84, 0x42, 0x35,
+    0x00, 0x00, 0x00, 0x01, 0x68, 0xce, 0x3c, 0x80, 0x00, 0x00, 0x00, 0x01, 0x06, 0x05, 0x21, 0x41,
+    0x4d, 0x53, 0x2d, 0x41, 0x55, 0x2d, 0x53, 0x45, 0x51, 0x2d, 0x56, 0x32, 0x21, 0x21, 0x21, 0x52,
+    0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x33, 0x65, 0x38,
+    0x80, 0x00, 0x00, 0x00, 0x01, 0x65, 0xb8, 0x00, 0x04, 0x09, 0xff, 0xff, 0xf8, 0x7a, 0x28, 0x00,
+    0x08, 0x1b, 0xf9, 0x3f, 0x0f, 0xff, 0xc3, 0xd1, 0x40, 0x00, 0x40, 0x6b, 0xc9, 0xd7, 0x5d, 0x75,
+    0xf1, 0xff, 0xfe, 0x1e, 0x8a, 0x00, 0x02, 0x0d, 0x5e, 0xfc, 0x61, 0xff, 0xf8, 0x7a, 0x28, 0x00,
+    0x08, 0x03, 0x7b, 0xea, 0x4a, 0xeb, 0xaf,
+];
+
+async fn bounded<F: Future>(why: &'static str, future: F) -> Check<F::Output> {
+    tokio::time::timeout(STEP_BOUND, future)
+        .await
+        .map_err(|_| why)
+}
+
+// Preserve the fixture owner after an unexpected setup panic, so cleanup still
+// runs before that panic is propagated. This wraps Future::poll, never IPC or
+// native outcomes, and introduces no task, dependency or production hook.
+async fn caught<F: Future>(future: F) -> std::thread::Result<F::Output> {
+    let mut future = Box::pin(future);
+    std::future::poll_fn(|cx| {
+        match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| future.as_mut().poll(cx))) {
+            Ok(Poll::Ready(value)) => Poll::Ready(Ok(value)),
+            Ok(Poll::Pending) => Poll::Pending,
+            Err(panic) => Poll::Ready(Err(panic)),
+        }
+    })
+    .await
+}
