+#[test]
+#[ignore = "real native IPC retirement; run this exact name alone with one test thread"]
+fn retired_exact_session_closes_idle_outbound_pipe_before_events_departure() {
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("fixture runtime");
+    let fixture_gate = runtime.block_on(crate::exclusive_connector_fixture());
+    let (port, ledger): (_, FiniteResourceProvider) = crate::test_resource_pair();
+    let root = ProcessResourceRoot::global();
+    let owner = root
+        .install_resource_provider(port)
+        .expect("same permanent process provider");
+    // Only process infrastructure is initialized here. The existing public root
+    // method prepares the permanent cleanup executor; its temporary scope is
+    // dropped BEFORE the immutable baseline. No Mesh/link/State/Events/flow or
+    // local socket exists yet, and no fixture allocation is absorbed later.
+    let bootstrap = root
+        .issue_mesh_connector_scope()
+        .expect("permanent cleanup infrastructure");
+    drop(bootstrap);
+    let report = owner.report();
+    assert_eq!(report.active_candidates, 0, "baseline owns no candidate");
+    assert_eq!(
+        report.failed_cleanup_candidates, 0,
+        "baseline cleanup is healthy"
+    );
+    assert!(
+        !report.accounting_poisoned && !report.cleanup.executor_failed,
+        "baseline owner is healthy"
+    );
+    assert_eq!(
+        (
+            report.cleanup.queued_jobs,
+            report.cleanup.active_jobs,
+            report.cleanup.failed_jobs
+        ),
+        (0, 0, 0),
+        "baseline has no cleanup work"
+    );
+    let baseline: ResourceClaim = ledger.in_use();
+    let baseline_reservations = ledger.active_reservations();
+    let baseline_scopes = ledger.active_scopes();
+
+    // This fixture-owned service root spends from the SAME actual Mesh provider;
+    // its joining owner lives outside the runtime and is released before the
+    // exact baseline check. It does not supply an alternate accounting oracle.
+    let cleanup_scope = root
+        .issue_local_application_scope()
+        .expect("fixture cleanup scope");
+    let cleanup_owner = myownmesh_services::ServiceCleanupOwner::new(cleanup_scope)
+        .expect("existing test grant funds fixture service cleanup");
+    let cleanup_port = cleanup_owner.port();
+    let (observed, cleanup, native_settled) = runtime.block_on(async move {
+        let mut fixture = Fixture::new();
+        let observed = caught(fixture.observe(cleanup_port)).await;
+        let cleanup = fixture.cleanup().await;
+        drop(fixture);
+        let settled = settle_connector_cleanup(&owner).await;
+        (observed, cleanup, settled)
+    });
+    drop(runtime);
+    let service_cleanup = cleanup_owner.close_and_join();
+
+    // Registry final-watchdog observers are external owners established by the
+    // production registry. Its Drop closes their channels after all our handler
+    // and watchdog handles were joined. Await their actual funded disposition,
+    // without resetting the provider or taking another baseline. The equality
+    // below is full/componentwise, including scope/reservation bookkeeping.
+    let deadline = std::time::Instant::now() + STEP_BOUND;
+    while ledger.in_use() != baseline
+        || ledger.active_reservations() != baseline_reservations
+        || ledger.active_scopes() != baseline_scopes
+    {
+        if std::time::Instant::now() >= deadline {
+            break;
+        }
+        std::thread::yield_now();
+    }
+    let final_use = ledger.in_use();
+    let final_reservations = ledger.active_reservations();
+    let final_scopes = ledger.active_scopes();
+    drop(fixture_gate);
+
+    // Setup, revocation, native close, socket/task joins and SAME-provider
+    // release are prerequisites. None can count as the selected idle-EOF defect.
+    assert!(cleanup.is_empty(), "fixture cleanup failures: {cleanup:?}");
+    native_settled.expect("fixture native cleanup must settle before semantic assertions");
+    let service_cleanup = service_cleanup.expect("fixture service cleanup worker joined");
+    assert_eq!(
+        (
+            service_cleanup.task_failures,
+            service_cleanup.worker_failures
+        ),
+        (0, 0),
+        "fixture service cleanup outcomes"
+    );
+    assert_eq!(
+        final_use, baseline,
+        "SAME Mesh provider must return exactly to its permanent baseline"
+    );
+    assert_eq!(
+        final_reservations, baseline_reservations,
+        "all fixture reservations released"
+    );
+    assert_eq!(final_scopes, baseline_scopes, "all fixture scopes released");
+    let observed = match observed {
+        Ok(result) => {
+            result.expect("fixture setup/revocation controls, not the idle-EOF criterion")
+        }
+        Err(panic) => std::panic::resume_unwind(panic),
+    };
+    assert_eq!(
+        observed.framed,
+        ExternalEnd::Eof,
+        "canonical stale frame must independently terminate the external pipe"
+    );
+    eprintln!("real_ipc_retirement_controls_and_cleanup_passed stale_write_completed={} idle_row_retained_noncurrent={} framed_row_retained_noncurrent={}",
+        observed.stale_write_completed, observed.idle_row_retained_noncurrent, observed.framed_row_retained_noncurrent);
+    assert_eq!(observed.idle, ExternalEnd::Eof,
+        "exact native session retirement must close the idle outbound pipe while its Events owner and client socket are still alive");
+}
