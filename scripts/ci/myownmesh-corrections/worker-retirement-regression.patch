+}
+
+async fn local_pair(
+    listener: &LocalSocketListener,
+    target: &listener::SocketTarget,
+) -> Check<(LocalSocketStream, LocalSocketStream)> {
+    let name = match target {
+        listener::SocketTarget::Path(path) => path
+            .as_path()
+            .to_fs_name::<GenericFilePath>()
+            .map_err(|_| "fixture local socket path")?,
+        listener::SocketTarget::Name(name) => name
+            .clone()
+            .to_ns_name::<GenericNamespaced>()
+            .map_err(|_| "fixture local socket name")?,
+    };
+    let (client, server) = tokio::join!(LocalSocketStream::connect(name), listener.accept());
+    Ok((
+        client.map_err(|_| "fixture local connect")?,
+        server.map_err(|_| "fixture local accept")?,
+    ))
+}
+
+async fn exchange(socket: &mut ClientSocket, request: &Request) -> Check<serde_json::Value> {
+    let mut encoded = serde_json::to_vec(request).map_err(|_| "fixture request encoding")?;
+    encoded.push(b'\n');
+    bounded("fixture request write bound", socket.write_all(&encoded))
+        .await?
+        .map_err(|_| "fixture request write")?;
+    bounded("fixture request flush bound", socket.flush())
+        .await?
+        .map_err(|_| "fixture request flush")?;
+    let mut line = String::new();
+    let bytes = bounded("fixture ACK read bound", socket.read_line(&mut line))
+        .await?
+        .map_err(|_| "fixture ACK read")?;
+    if bytes == 0 {
+        return Err("fixture ACK was EOF");
+    }
+    let response: Response = serde_json::from_str(&line).map_err(|_| "fixture ACK JSON")?;
+    if !response.ok {
+        return Err("fixture request refused");
+    }
+    response.data.ok_or("fixture ACK omitted data")
+}
+
+fn read_is_pending(socket: &mut ClientSocket) -> bool {
+    let mut byte = [0u8; 1];
+    let mut read = Box::pin(socket.read(&mut byte));
+    read.as_mut()
+        .poll(&mut TaskContext::from_waker(Waker::noop()))
+        .is_pending()
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum ExternalEnd {
+    Eof,
+    UnexpectedByte,
+    ReadError,
+    TimedOut,
+}
+
+async fn external_end(socket: &mut ClientSocket) -> ExternalEnd {
+    let mut byte = [0u8; 1];
+    match tokio::time::timeout(STEP_BOUND, socket.read(&mut byte)).await {
+        Ok(Ok(0)) => ExternalEnd::Eof,
+        Ok(Ok(_)) => ExternalEnd::UnexpectedByte,
+        Ok(Err(_)) => ExternalEnd::ReadError,
+        Err(_) => ExternalEnd::TimedOut,
+    }
+}
+
+fn canonical_frame() -> Check<Vec<u8>> {
+    let mut body = Vec::new();
+    body.push(u8::try_from(FRAME_LABEL.len()).map_err(|_| "fixture label size")?);
+    body.push(0);
+    body.extend_from_slice(&40_000u32.to_le_bytes());
+    body.extend_from_slice(&(VIDEO.len() as u32).to_le_bytes());
+    body.extend_from_slice(FRAME_LABEL);
+    body.extend_from_slice(VIDEO);
+    // Use the production parser to rule out a malformed-frame control.
+    let parsed = decode_realtime_send_unit(&body).ok_or("fixture canonical frame decode")?;
+    if parsed.flow_label != FRAME_LABEL || parsed.payload != VIDEO || parsed.duration_us != 40_000 {
+        return Err("fixture canonical frame differs");
+    }
+    let mut frame = Vec::new();
+    frame.extend_from_slice(&(body.len() as u32).to_le_bytes());
+    frame.extend_from_slice(&body);
+    Ok(frame)
+}
+
+#[derive(Debug)]
+struct Observation {
+    idle: ExternalEnd,
+    framed: ExternalEnd,
+    stale_write_completed: bool,
+    idle_row_retained_noncurrent: bool,
+    framed_row_retained_noncurrent: bool,
+}
+
+struct Fixture {
+    meshes: [Option<MeshHandle>; 2],
+    networks: Arc<NetworkRegistry>,
+    loose_near: Option<JoinedNetwork>,
+    near: Option<Arc<JoinedNetwork>>,
+    far: Option<JoinedNetwork>,
+    link: Option<TransportLabRetirableSession>,
+    state: Option<Arc<ControlState>>,
+    owner: Option<FundedArc<ClientHandle>>,
+    loose_flow: Option<myownmesh_core::realtime::RealtimeFlowHandle>,
+    capabilities: [Option<String>; 2],
+    events: Option<ClientSocket>,
+    pipes: [Option<ClientSocket>; 2],
+    tasks: LeasedList<ConnectionTask>,
+    listener: Option<LocalSocketListener>,
+    target: Option<listener::SocketTarget>,
+    directory: Option<tempfile::TempDir>,
+}
+
+impl Fixture {
+    fn new() -> Self {
+        Self {
+            meshes: [None, None],
+            networks: NetworkRegistry::new(),
+            loose_near: None,
+            near: None,
+            far: None,
+            link: None,
+            state: None,
+            owner: None,
+            loose_flow: None,
+            capabilities: [None, None],
+            events: None,
+            pipes: [None, None],
+            tasks: LeasedList::new(),
+            listener: None,
+            target: None,
+            directory: None,
+        }
+    }
+
+    async fn connection(&mut self) -> Check<ClientSocket> {
+        let state = self.state.as_ref().ok_or("fixture state missing")?;
+        // Admit BOTH the task and retained join node before accepting/spawning.
+        // No task is detached; cleanup pops and awaits every funded handle.
+        let admission = state
+            .clients
+            .lease_task()
+            .map_err(|_| "fixture IPC task funding")?;
+        let node = state
+            .clients
+            .acquire_claim(
+                LeasedList::<ConnectionTask>::node_claim()
+                    .map_err(|_| "fixture join node claim")?,
+            )
+            .map_err(|_| "fixture join node funding")?;
+        let (client, server) = bounded(
+            "fixture local pair bound",
+            local_pair(
+                self.listener.as_ref().ok_or("fixture listener missing")?,
+                self.target
+                    .as_ref()
+                    .ok_or("fixture socket target missing")?,
+            ),
+        )
+        .await??;
+        let state = Arc::clone(state);
+        let task = tokio::spawn(async move {
+            let _admission = admission;
+            handle_client(server, state).await
+        });
+        self.tasks.push(task, node);
+        Ok(BufReader::new(client))
+    }
+
+    async fn observe(
+        &mut self,
+        cleanup: myownmesh_services::ServiceCleanupPort,
+    ) -> Check<Observation> {
+        for index in 0..2 {
+            self.meshes[index] = Some(
+                Mesh::open_connector_capable_with_identity(
+                    MeshConfig::default(),
+                    Arc::new(myownmesh_core::Identity::ephemeral()),
+                    connector_policy()?,
+                )
+                .await
+                .map_err(|_| "fixture connector Mesh")?,
+            );
+        }
+        self.loose_near = Some(
+            self.meshes[0]
+                .as_ref()
+                .ok_or("fixture near Mesh")?
+                .join(crate::test_link::fresh_network(
+                    NETWORK,
+                    "real-ipc-retirement-mesh",
+                ))
+                .await
+                .map_err(|_| "fixture near join")?,
+        );
+        self.far = Some(
+            self.meshes[1]
+                .as_ref()
+                .ok_or("fixture far Mesh")?
+                .join(crate::test_link::fresh_network(
+                    "retirement-far",
+                    "real-ipc-retirement-mesh",
+                ))
+                .await
+                .map_err(|_| "fixture far join")?,
+        );
+        if let Some(refused) = self
+            .networks
+            .insert(
+                self.loose_near.take().ok_or("fixture near join absent")?,
+                None,
+            )
+            .into_refusal()
+        {
+            self.loose_near = Some(refused.joined);
+            return Err("fixture network registry insert");
+        }
+        self.near = self.networks.get(NETWORK);
+        let near = Arc::clone(
+            self.near
+                .as_ref()
+                .ok_or("fixture registered near network")?,
+        );
+        self.link = Some(
+            tokio::time::timeout(
+                CONNECT_BOUND,
+                near.install_retirable_session_over_real_link(
+                    self.far.as_ref().ok_or("fixture far network")?,
+                ),
+            )
+            .await
+            .map_err(|_| "fixture real native link bound")?,
+        );
+        let peer = self
+            .link
+            .as_ref()
+            .ok_or("fixture captured link missing")?
+            .peer_device_id()
+            .to_owned();
+        let mesh = self.meshes[0]
+            .as_ref()
+            .ok_or("fixture near Mesh missing")?
+            .clone();
+        let clients = ClientRegistry::new(
+            mesh.local_application_resource_scope()
+                .map_err(|_| "fixture registry scope")?,
+        )
+        .map_err(|_| "fixture real registry funding")?;
+        let services = ServiceManager::new(mesh.clone(), Arc::clone(&self.networks), cleanup);
+        self.state = Some(Arc::new(ControlState {
+            finished: tokio::sync::Notify::new(),
+            ended: std::sync::atomic::AtomicUsize::new(0),
+            abnormal_connections: std::sync::atomic::AtomicUsize::new(0),
+            mesh,
+            registry: Arc::clone(&self.networks),
+            services,
+            clients,
+            realtime: advert(),
+            supervisor: RuntimeSupervisor::new(),
+            json_line_bytes: None,
+            realtime_frame_bytes: None,
+            before_events_subscribe_commit: None,
+            at_events_stream_entry: None,
+            before_rpc_call: None,
+            before_begin_closing: None,
+            before_provisional_settle: None,
+            before_mfa_response_write: None,
+            #[cfg(feature = "transport-lab")]
+            mfa_transport_lab_barrier: None,
+        }));
+        self.directory = Some(tempfile::tempdir().map_err(|_| "fixture private socket directory")?);
+        let directory = self.directory.as_ref().ok_or("fixture directory missing")?;
+        #[cfg(unix)]
+        let target =
+            listener::SocketTarget::Path(directory.path().join("private").join("control.sock"));
+        #[cfg(not(unix))]
+        let target = listener::SocketTarget::Name(format!(
+            "myownmesh-retirement-{}",
+            directory
+                .path()
+                .file_name()
+                .and_then(|part| part.to_str())
+                .ok_or("fixture unique socket name")?
+        ));
+        self.listener =
+            Some(bind_listener(&target).map_err(|_| "fixture owner-only listener bind")?);
+        self.target = Some(target);
+
+        let mut events = self.connection().await?;
+        let data = exchange(&mut events, &Request::EventsSubscribe).await?;
+        let id: ClientId =
+            serde_json::from_value(data.get("client_id").ok_or("fixture Events id")?.clone())
+                .map_err(|_| "fixture Events id decode")?;
+        let capability = data
+            .get("client_capability")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("fixture Events capability")?;
+        let state = Arc::clone(self.state.as_ref().ok_or("fixture state absent")?);
+        self.owner = state.clients.authenticate(id, capability);
+        self.events = Some(events);
+        let owner = self
+            .owner
+            .as_ref()
+            .ok_or("fixture real Events authentication")?
+            .clone();
+        for (index, label, video) in [(0, IDLE_LABEL, false), (1, FRAME_LABEL, true)] {
+            self.loose_flow = Some(
+                bounded(
+                    "fixture flow open bound",
+                    near.open_webrtc_realtime(&peer, flow_open(label, video)),
+                )
+                .await?
+                .map_err(|_| "fixture real flow open")?,
+            );
+            let capability = match state.clients.install_realtime_flow(
+                &owner,
+                NETWORK.to_owned(),
+                self.loose_flow.take().ok_or("fixture opened flow absent")?,
+            ) {
+                Ok(capability) => capability.expose().to_owned(),
+                Err(refused) => {
+                    self.loose_flow = Some(refused.flow);
+                    return Err("fixture real flow registration");
+                }
+            };
+            self.capabilities[index] = Some(capability.clone());
+            if owner.with_realtime_flow(&capability, NETWORK, |flow| near.realtime_is_current(flow))
+                != Some(true)
+            {
+                return Err("fixture captured flow was not current before retirement");
+            }
+            let mut socket = self.connection().await?;
+            let ack = exchange(
+                &mut socket,
+                &Request::RealtimePipe {
+                    direction: RealtimePipeDirection::Outbound,
+                    network: NETWORK.to_owned(),
+                    peer: None,
+                    client_id: Some(id),
+                    client_capability: Some(owner.capability().to_owned()),
+                    flow_capability: Some(capability),
+                },
+            )
+            .await?;
+            if ack
+                .get("realtime_pipe")
+                .and_then(serde_json::Value::as_bool)
+                != Some(true)
+            {
+                return Err("fixture outbound pipe ACK missing");
+            }
+            if !read_is_pending(&mut socket) {
+                return Err("fixture live-idle pipe did not stay open");
+            }
+            self.pipes[index] = Some(socket);
+        }
+        if !state.clients.is_current_owner(&owner) {
+            return Err("fixture Events owner ended early");
+        }
+        // This API consumes the ORIGINAL captured channel/session witnesses. It
+        // synchronously revokes both before its native await, then joins both
+        // event pumps and retired workers. ACK or replacement ACTIVE is no oracle.
+        let outcomes = bounded(
+            "fixture exact session retirement bound",
+            self.link
+                .take()
+                .ok_or("fixture original link missing")?
+                .retire_sessions(),
+        )
+        .await?;
+        if outcomes.len() < 2 || outcomes.iter().any(std::result::Result::is_err) {
+            return Err("fixture original native retirement failed");
+        }
+        let after = [0, 1].map(|index| {
+            owner.with_realtime_flow(
+                self.capabilities[index].as_deref().unwrap_or(""),
+                NETWORK,
+                |flow| near.realtime_is_current(flow),
+            )
+        });
+        // A future close may legitimately consume a row. Neither an absent row
+        // nor a held/noncurrent handle may become current again under a label.
+        if after.iter().any(|current| *current == Some(true)) {
+            return Err("fixture captured flow stayed current after native retirement");
+        }
+        if !state.clients.is_current_owner(&owner) {
+            return Err("fixture retirement revoked Events owner");
+        }
+        let idle = external_end(self.pipes[0].as_mut().ok_or("fixture idle socket absent")?).await;
+        let frame = canonical_frame()?;
+        let framed = self.pipes[1]
+            .as_mut()
+            .ok_or("fixture stale-frame socket absent")?;
+        // A future fix may have closed before this write. A write error is not
+        // itself EOF evidence; the independent external read below must be EOF.
+        let stale_write_completed = bounded(
+            "fixture canonical stale-frame write bound",
+            framed.write_all(&frame),
+        )
+        .await?
+        .is_ok();
+        let framed = external_end(framed).await;
+        if !state.clients.is_current_owner(&owner) {
+            return Err("fixture Events owner ended during observations");
+        }
+        Ok(Observation {
+            idle,
+            framed,
+            stale_write_completed,
+            idle_row_retained_noncurrent: after[0] == Some(false),
+            framed_row_retained_noncurrent: after[1] == Some(false),
+        })
+    }
+
+    async fn cleanup(&mut self) -> Vec<&'static str> {
+        let mut errors = Vec::new();
+        // All observations precede client close, registry drain and shutdown.
+        self.pipes = [None, None];
+        self.events = None;
+        self.listener = None;
+        self.target = None;
+        if let Some(link) = self.link.take() {
+            match bounded("cleanup original session bound", link.retire_sessions()).await {
+                Ok(outcomes)
+                    if outcomes.len() >= 2 && outcomes.iter().all(std::result::Result::is_ok) => {}
+                _ => errors.push("cleanup original native session"),
+            }
+        }
+        if let Some(flow) = self.loose_flow.take() {
+            if let Some(near) = self.near.as_ref() {
+                match bounded("cleanup uninstalled flow bound", near.close_realtime(flow)).await {
+                    Ok(Ok(()))
+                    | Ok(Err(myownmesh_core::realtime::RealtimeRefusal::SessionNotCurrent)) => {}
+                    _ => errors.push("cleanup uninstalled flow"),
+                }
+            } else {
+                drop(flow);
+                errors.push("cleanup uninstalled flow lacked its network");
+            }
+        }
+        if let Some(state) = self.state.as_ref() {
+            state.clients.begin_closing();
+            while let Some(id) = state.clients.shutdown_next() {
+                if let Some(removed) = state.clients.unregister(id) {
+                    if bounded(
+                        "cleanup owned registrations bound",
+                        release_owned_registrations(state, removed),
+                    )
+                    .await
+                    .is_err()
+                    {
+                        errors.push("cleanup owned registrations");
+                    }
+                }
+            }
+            state.clients.shutdown_settle_pending();
+        }
+        while let Some(mut task) = self.tasks.pop() {
+            match tokio::time::timeout(STEP_BOUND, &mut task).await {
+                Ok(Ok(Ok(()))) => {}
+                Ok(_) => errors.push("cleanup IPC handler result"),
+                Err(_) => {
+                    errors.push("cleanup IPC handler bound");
+                    task.abort();
+                    // Abort is a failed setup/cleanup outcome, never a passing
+                    // regression control. Still observe this exact owned handle.
+                    if tokio::time::timeout(STEP_BOUND, &mut task).await.is_err() {
+                        errors.push("cleanup aborted IPC handler join bound");
+                    }
+                }
+            }
+        }
+        self.owner = None;
+        self.capabilities = [None, None];
+        if let Some(state) = self.state.take() {
+            match bounded(
+                "cleanup watchdog joins bound",
+                state.clients.drain_watchdogs(),
+            )
+            .await
+            {
+                Ok(0) => {}
+                _ => errors.push("cleanup watchdog joins"),
+            }
+            if bounded(
+                "cleanup IPC task count bound",
+                state.clients.wait_for_tasks(),
+            )
+            .await
+            .is_err()
+            {
+                errors.push("cleanup IPC task count");
+            }
+            state.clients.finish_closed();
+            if state.clients.residue() != RegistryResidue::empty(Lifecycle::Closed) {
+                errors.push("cleanup IPC registry residue");
+            }
+            if bounded("cleanup services bound", state.services.shutdown())
+                .await
+                .map(|r| r.is_ok())
+                != Ok(true)
+            {
+                errors.push("cleanup services");
+            }
+            drop(state);
+        }
+        let near_shutdown = self.networks.shutdown_all();
+        let far_shutdown = async {
+            match self.far.as_ref() {
+                Some(far) => far.shutdown().await.map_err(|_| ()),
+                None => Ok(()),
+            }
+        };
+        match bounded("cleanup joined drivers bound", async {
+            tokio::join!(near_shutdown, far_shutdown)
+        })
+        .await
+        {
+            Ok((near, far)) => {
+                if near.iter().any(std::result::Result::is_err) {
+                    errors.push("cleanup near driver");
+                }
+                if far.is_err() {
+                    errors.push("cleanup far driver");
+                }
+            }
+            Err(_) => errors.push("cleanup joined drivers bound"),
+        }
+        if let Some(near) = self.loose_near.take() {
+            if bounded("cleanup unregistered near driver bound", near.shutdown())
+                .await
+                .map(|r| r.is_ok())
+                != Ok(true)
+            {
+                errors.push("cleanup unregistered near driver");
+            }
+            drop(near);
+        }
+        self.near = None;
+        self.far = None;
+        self.meshes = [None, None];
+        self.directory = None;
+        errors
+    }
+}
+
+async fn settle_connector_cleanup(owner: &ConnectorResourceOwnerPort) -> Check<()> {
+    bounded("fixture connector cleanup settlement bound", async {
+        loop {
+            let report = owner.report();
+            if report.failed_cleanup_candidates != 0
+                || report.accounting_poisoned
+                || report.cleanup.failed_jobs != 0
+                || report.cleanup.executor_failed
+            {
+                return Err("fixture connector cleanup diagnostics failed");
+            }
+            if report.active_candidates == 0
+                && report.cleanup.queued_jobs == 0
+                && report.cleanup.active_jobs == 0
+            {
+                return Ok(());
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await?
+}
