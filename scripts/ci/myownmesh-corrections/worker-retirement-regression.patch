+        crate::test_resource_provider(),
+        profile,
+    ))
+}
+
+fn flow_open(label: &[u8], video: bool) -> WebRtcRealtimeFlowOpen {
+    WebRtcRealtimeFlowOpen {
+        label: label.to_vec(),
+        direction: myownmesh_core::realtime::RealtimeFlowDirection::Outbound,
+        kind: if video {
+            WebRtcRtpKind::Video
+        } else {
+            WebRtcRtpKind::Audio
+        },
+        mime: if video { "video/H264" } else { "audio/opus" }.to_owned(),
+        clock_rate: if video { 90_000 } else { 48_000 },
+        channels: if video { 0 } else { 2 },
