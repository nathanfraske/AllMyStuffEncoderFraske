+                Self::handle_names_live_flow(flows, handle)?;
+                if !flows.is_current(session, Some(live), handle.name()) {
+                    return Err(RealtimeFlowError::SessionNotCurrent);
+                }
+                let claim = RealtimeWorkerRetirement::retained_claim()
+                    .map_err(|_| RealtimeFlowError::FlowRefused)?;
+                let retained = session
+                    .validity_witness()
+                    .reserve_retained(claim)
+                    .map_err(|_| RealtimeFlowError::FlowRefused)?;
+                Ok(worker.observe_realtime_retirement(retained))
+            },
+        ) {
+            Ok(observer) => Ok(observer),
+            Err(RealtimeFlowError::SessionNotCurrent) => Ok(RealtimeWorkerRetirement::unusable()),
+            Err(error) => Err(error.into()),
+        }
+    }
