+
+        // Never let the generic owner helper select a worker for an unstamped
+        // handle. This observer can name only its already captured worker.
+        if handle.owner().worker().is_none() {
+            return Ok(RealtimeWorkerRetirement::unusable());
+        }
+        match self.with_owned_realtime_flows_and_worker(
