+/// A wait-only view of one exact native worker's unusability.
+///
+/// This owns neither the worker nor a flow, and is deliberately not cloneable.
+/// Readiness is not a native-close acknowledgement or an individual-flow close.
+pub(crate) struct RealtimeWorkerRetirement {
+    retirement: Option<watch::Receiver<bool>>,
+    // Last: receiver and its wait bookkeeping must drop before their funding.
+    _retained: Option<crate::resource::ResourceLease>,
+}
+
+impl RealtimeWorkerRetirement {
+    pub(crate) fn unusable() -> Self {
+        Self {
+            retirement: None,
+            _retained: None,
+        }
+    }
+
+    pub(crate) fn retained_claim() -> std::result::Result<
+        crate::resource::ResourceClaim,
+        crate::resource::ResourceClaimArithmeticError,
+    > {
+        // Reserve the visible observer plus the actual inline wait future,
+        // including its dependency wait bookkeeping. The empty measurement
+        // value subscribes to nothing and retains no shared state or lease.
+        let waiting = Self::unusable().wait();
+        let bytes = size_of::<Self>()
+            .checked_add(std::mem::size_of_val(&waiting))
+            .and_then(|bytes| u64::try_from(bytes).ok())
+            .ok_or(crate::resource::ResourceClaimArithmeticError::Overflow {
+                dimension: crate::resource::ResourceClass::AccountedMemoryBytes,
+            })?;
+        crate::resource::ResourceClaim::try_from_entries([
+            (crate::resource::ResourceClass::AccountedMemoryBytes, bytes),
+            // The retained watch shared allocation has dependency-private
+            // metadata; it may outlive its original sender while we wait.
+            (crate::resource::ResourceClass::OpaqueDependencyResidual, 1),
+        ])
+    }
+
+    pub(crate) async fn wait(mut self) {
+        if let Some(retirement) = self.retirement.as_mut() {
+            loop {
+                // Subscribe marks the current version seen. Check the value
+                // first so retirement before capture is immediately ready.
+                if *retirement.borrow() {
+                    return;
+                }
+                if retirement.changed().await.is_err() {
+                    // Sender absence proves unusability, not native cleanup.
+                    return;
+                }
+            }
+        }
+    }
+}
