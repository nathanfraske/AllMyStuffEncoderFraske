+    pub(crate) fn observe_realtime_worker_retirement(
+        &self,
+        handle: &crate::realtime::RealtimeFlowHandle,
+    ) -> std::result::Result<
+        crate::transport::webrtc::RealtimeWorkerRetirement,
+        crate::realtime::RealtimeRefusal,
