@@ -0,0 +1,176 @@
+//! Regression at the native sample/bind boundary. The real packetizer writes
+//! into a capture writer; this does not establish delivery to a remote peer.
+
+use std::future::{poll_fn, Future};
+use std::pin::pin;
+use std::sync::{Arc, Mutex};
+use std::task::Poll;
+use std::time::Duration;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use interceptor::Attributes;
+use media::Sample;
+use portable_atomic::AtomicBool;
+use rtp::packet::Packet;
+
+use super::track_local_static_sample::TrackLocalStaticSample;
+use super::{TrackLocal, TrackLocalContext, TrackLocalWriter};
+use crate::error::Result;
+use crate::rtp_transceiver::rtp_codec::{
+    RTCRtpCodecCapability, RTCRtpCodecParameters, RTCRtpParameters,
+};
+
+const TEST_DEADLINE: Duration = Duration::from_secs(5);
+// Distinct opaque sample bodies test packetization and custody, not decoding.
+const FIRST: &[u8] = b"mesh04-first-owned-sample";
+const SECOND: &[u8] = b"mesh04-second-owned-sample";
+
+#[derive(Debug, Default)]
+struct CapturedPackets {
+    packets: Mutex<Vec<Packet>>,
+}
+
+impl CapturedPackets {
+    fn snapshot(&self) -> Vec<Packet> {
+        self.packets.lock().unwrap().clone()
+    }
+}
+
+#[async_trait]
+impl TrackLocalWriter for CapturedPackets {
+    async fn write_rtp_with_attributes(
+        &self,
+        packet: &Packet,
+        _attributes: &Attributes,
+    ) -> Result<usize> {
+        let mut packets = self.packets.lock().unwrap();
+        assert!(packets.len() < 3, "unexpected duplicate native packet");
+        packets.push(packet.clone());
+        Ok(packet.payload.len())
+    }
+}
+
+fn fixture() -> (
+    TrackLocalStaticSample,
+    TrackLocalContext,
+    Arc<CapturedPackets>,
+) {
+    let codec = RTCRtpCodecCapability {
+        mime_type: "audio/opus".to_owned(),
+        clock_rate: 48000,
+        channels: 2,
+        ..Default::default()
+    };
+    let track = TrackLocalStaticSample::new(
+        codec.clone(),
+        "mesh04-startup".to_owned(),
+        "mesh04-private-test".to_owned(),
+    );
+    let writer = Arc::new(CapturedPackets::default());
+    let context = TrackLocalContext {
+        id: "mesh04-bound-sender".to_owned(),
+        params: RTCRtpParameters {
+            codecs: vec![RTCRtpCodecParameters {
+                capability: codec,
+                payload_type: 111,
+                ..Default::default()
+            }],
+            ..Default::default()
+        },
+        ssrc: 0x4d_45_53_48,
+        write_stream: writer.clone(),
+        paused: Arc::new(AtomicBool::new(false)),
+        mid: None,
+    };
+    (track, context, writer)
+}
+
+fn sample(data: &'static [u8]) -> Sample {
+    Sample {
+        data: Bytes::from_static(data),
+        duration: Duration::from_millis(20),
+        ..Default::default()
+    }
+}
+
+async fn bounded<T>(work: impl Future<Output = T>) -> T {
+    tokio::time::timeout(TEST_DEADLINE, work)
+        .await
+        .expect("native regression operation must finish within its test bound")
+}
+
+#[tokio::test]
+async fn mesh04_prebind_sample_waits_then_emits_first_once_in_order() {
+    let (track, context, writer) = fixture();
+    let first = sample(FIRST);
+    let mut pending = pin!(track.write_sample(&first));
+    poll_fn(|cx| match pending.as_mut().poll(cx) {
+        Poll::Pending => Poll::Ready(()),
+        Poll::Ready(result) => {
+            panic!("unbound first sample must remain pending, not complete: {result:?}")
+        }
+    })
+    .await;
+    assert!(writer.snapshot().is_empty());
+
+    bounded(track.bind(&context)).await.unwrap();
+    bounded(pending).await.unwrap();
+    let first_packets = writer.snapshot();
+    assert_eq!(
+        first_packets.len(),
+        1,
+        "first sample must emit exactly once"
+    );
+    assert_eq!(first_packets[0].payload.as_ref(), FIRST);
+    assert_eq!(first_packets[0].header.payload_type, 111);
+    assert_eq!(first_packets[0].header.ssrc, context.ssrc);
+
+    bounded(track.write_sample(&sample(SECOND))).await.unwrap();
+    let packets = writer.snapshot();
+    assert_eq!(packets.len(), 2, "no duplicate or lost native sample");
+    assert_eq!(packets[0].payload.as_ref(), FIRST);
+    assert_eq!(packets[1].payload.as_ref(), SECOND);
+    assert_eq!(
+        packets[1].header.sequence_number,
+        packets[0].header.sequence_number.wrapping_add(1)
+    );
+    assert_eq!(
+        packets[1]
+            .header
+            .timestamp
+            .wrapping_sub(packets[0].header.timestamp),
+        960,
+        "twenty milliseconds at the registered 48 kHz clock"
+    );
+    bounded(track.unbind(&context)).await.unwrap();
+}
+
+#[tokio::test]
+async fn mesh04_cancelled_prebind_sample_is_never_emitted_after_bind() {
+    let (track, context, writer) = fixture();
+    let first = sample(FIRST);
+    {
+        let mut cancelled = pin!(track.write_sample(&first));
+        poll_fn(|cx| match cancelled.as_mut().poll(cx) {
+            Poll::Pending => Poll::Ready(()),
+            Poll::Ready(result) => {
+                panic!("cancellation must exercise a polled pending write: {result:?}")
+            }
+        })
+        .await;
+        assert!(writer.snapshot().is_empty());
+        // The future is dropped here after it has actually waited for bind.
+    }
+
+    bounded(track.bind(&context)).await.unwrap();
+    assert!(
+        writer.snapshot().is_empty(),
+        "bind must not replay a cancelled caller's sample"
+    );
+    bounded(track.write_sample(&sample(SECOND))).await.unwrap();
+    let packets = writer.snapshot();
+    assert_eq!(packets.len(), 1, "only the current caller owns a sample");
+    assert_eq!(packets[0].payload.as_ref(), SECOND);
+    bounded(track.unbind(&context)).await.unwrap();
+}
