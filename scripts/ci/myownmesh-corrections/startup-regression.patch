+//! Real unbound native sender, existing funded flow queue and actual pump.
+//! No signaling/remote peer or received-media claim is part of these controls.
+
+use super::*;
+
+const STARTUP_TEST_BOUND: Duration = Duration::from_secs(5);
+const STARTUP_UNIT: &[u8] = b"mesh04-owned-first-unit";
+
+struct StartupPumpFixture {
+    registry: Arc<RealtimeFlowRegistry>,
+    flows: SessionRealtimeFlows,
+    session: FlowFixtureSession,
+    name: RealtimeFlowName,
+    incarnation: Arc<WebRtcConnectorIncarnation>,
+    native: Arc<TrackLocalStaticSample>,
+    sender: Arc<RTCRtpSender>,
+    pc: Arc<RTCPeerConnection>,
+    close_owner: Arc<ConnectorCloseOwner>,
+    _attempt: AttemptLifetime,
+    _resource_owner: MeshConnectorResourceScope,
+}
+
+impl StartupPumpFixture {
+    async fn new() -> Self {
+        let codec = webrtc::rtp_transceiver::rtp_codec::RTCRtpCodecCapability {
+            mime_type: "audio/opus".to_owned(),
+            clock_rate: 48_000,
+            channels: 2,
+            ..Default::default()
+        };
+        let mut media = webrtc::api::media_engine::MediaEngine::default();
+        media
+            .register_codec(
+                webrtc::rtp_transceiver::rtp_codec::RTCRtpCodecParameters {
+                    capability: codec.clone(),
+                    payload_type: 111,
+                    ..Default::default()
+                },
+                webrtc::rtp_transceiver::rtp_codec::RTPCodecType::Audio,
+            )
+            .unwrap();
+        let pc = Arc::new(
+            webrtc::api::APIBuilder::new()
+                .with_media_engine(media)
+                .build()
+                .new_peer_connection(
+                    webrtc::peer_connection::configuration::RTCConfiguration::default(),
+                )
+                .await
+                .unwrap(),
+        );
+        let native = Arc::new(TrackLocalStaticSample::new(
+            codec,
+            "mesh04-prebind".to_owned(),
+            "mesh04-private-regression".to_owned(),
+        ));
+        let sender = pc
+            .add_track(Arc::clone(&native)
+                as Arc<dyn webrtc::track::track_local::TrackLocal + Send + Sync>)
+            .await
+            .unwrap();
+        assert!(sender.track().await.is_some());
+
+        let resource_owner = test_resource_owner(1, NATIVE_LOOPBACK_CALLBACK_CAPACITY);
+        let (close_owner, attempt) = close_owner_fixture(&resource_owner);
+        assert!(close_owner.attach_native(Arc::clone(&pc)));
+        let registry = test_realtime_registry(explicit_realtime_workload(
+            STARTUP_UNIT.len(),
+            1,
+            1,
+            STARTUP_UNIT.len(),
+            1,
+        ));
+        let incarnation = Arc::clone(&close_owner.ownership.incarnation);
+        let session = FlowFixtureSession {
+            incarnation: Arc::clone(incarnation.generic()),
+        };
+        let name = fixture_flow_name();
+        let mut flows = SessionRealtimeFlows::new(
+            Arc::clone(&registry),
+            Some(session_flow::leased_control_profile(&registry)),
+        );
+        flows
+            .open(
+                &session,
+                Some(incarnation.generic()),
+                RealtimeFlowSpec {
+                    name: name.clone(),
+                    direction: RealtimeDirection::Outbound,
+                    encoding: RealtimeEncoding::new(WebRtcRtpKind::Audio, "audio/opus", 48_000, 2)
+                        .unwrap(),
+                },
+            )
+            .unwrap();
+        Self {
+            registry,
+            flows,
+            session,
+            name,
+            incarnation,
+            native,
+            sender,
+            pc,
+            close_owner,
+            _attempt: attempt,
+            _resource_owner: resource_owner,
+        }
+    }
+
+    fn enqueue(&mut self) {
+        self.flows
+            .send(
+                &self.session,
+                Some(self.incarnation.generic()),
+                &self.name,
+                RealtimeSendUnit {
+                    data: Bytes::from_static(STARTUP_UNIT),
+                    pace: Duration::from_millis(20),
+                },
+            )
+            .unwrap();
+    }
+
+    fn retained_payload_bytes(&self) -> usize {
+        retained_realtime_bytes(&self.registry.state.lock())
+    }
+
+    fn attach(&mut self) -> usize {
+        let track = RealtimeOutboundTrack {
+            track: Arc::clone(&self.native),
+            sender: Arc::clone(&self.sender),
+            pc: Arc::clone(&self.pc),
+            incarnation: Arc::clone(&self.incarnation),
+            close_owner: Arc::clone(&self.close_owner),
+        };
+        // On this current-thread runtime no spawned task can poll before this
+        // synchronous call returns. The unchanged pump clones the native track
+        // on entry. That observable ownership is only a start barrier: payload
+        // funding, actual sender detachment and terminal ACK are the assertions.
+        let before = Arc::strong_count(&self.native);
+        if let Err((error, _track)) = self.flows.attach_outbound(
+            &self.session,
+            Some(self.incarnation.generic()),
+            &self.name,
+            track,
+        ) {
+            panic!("finite startup fixture could not attach its native track: {error:?}");
+        }
+        before
+    }
+
+    async fn observe_started(&self, before: usize) -> bool {
+        tokio::time::timeout(STARTUP_TEST_BOUND, async {
+            while Arc::strong_count(&self.native) <= before {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .is_ok()
+    }
+
+    async fn close_and_join(mut self) {
+        let remains = self
+            .flows
+            .close(&self.session, Some(self.incarnation.generic()), &self.name)
+            .unwrap();
+        let RealtimeFlowRemains::Outbound(retired) = remains else {
+            panic!("the attached native pump must return its exact retirement ACK");
+        };
+        tokio::time::timeout(STARTUP_TEST_BOUND, retired)
+            .await
+            .expect("closing an unbound flow must finish without a future bind")
+            .expect("native retirement must acknowledge, not drop its sender");
+        assert!(
+            self.sender.track().await.is_none(),
+            "retirement ACK follows actual native sender detachment"
+        );
+        assert_eq!(self.retained_payload_bytes(), 0);
+        assert!(realtime_accounting_is_clean(&self.registry.state.lock()));
+        assert!(
+            self.flows.is_quiescent(),
+            "no native tail remains after ACK"
+        );
+        self.close_owner.seal_transport_tasks();
+        tokio::time::timeout(STARTUP_TEST_BOUND, self.close_owner.wait())
+            .await
+            .expect("the cleanup owner must join its actual pump and native close")
+            .unwrap();
+    }
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn mesh04_prebind_queue_keeps_first_payload_funded_until_finite_close() {
+    let mut fixture = tokio::time::timeout(STARTUP_TEST_BOUND, StartupPumpFixture::new())
+        .await
+        .expect("native startup fixture must finish within its test bound");
+    fixture.enqueue();
+    let funded = fixture.retained_payload_bytes();
+    assert!(
+        funded > 0,
+        "the first queued payload must hold a real lease"
+    );
+    let before = fixture.attach();
+    let began = fixture.observe_started(before).await;
+    let waiting_funding = fixture.retained_payload_bytes();
+    // Clean up even on the pristine baseline's expected accounting failure.
+    fixture.close_and_join().await;
+    assert!(
+        began,
+        "the actual pump must have started before observation"
+    );
+    assert_eq!(
+        waiting_funding, funded,
+        "prebind waiting must not dequeue the first unit or release its payload lease"
+    );
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn mesh04_connector_retirement_detaches_unbound_idle_sender_before_queue_close() {
+    let mut fixture = tokio::time::timeout(STARTUP_TEST_BOUND, StartupPumpFixture::new())
+        .await
+        .expect("native startup fixture must finish within its test bound");
+    let before = fixture.attach();
+    let began = fixture.observe_started(before).await;
+    // Keep the flow and its empty queue alive. Only this exact connector's
+    // retirement can finish the pending initial bind wait at this point.
+    fixture.incarnation.retire();
+    let detached_before_close = tokio::time::timeout(STARTUP_TEST_BOUND, async {
+        while fixture.sender.track().await.is_some() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .is_ok();
+    // Baseline still gets a queue close and owned cleanup before failing.
+    fixture.close_and_join().await;
+    assert!(began);
+    assert!(
+        detached_before_close,
+        "connector retirement must end the unbound idle pump without queue close or bind"
+    );
+}
