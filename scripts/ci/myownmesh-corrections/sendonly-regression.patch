+#[ignore = "opens two native peer connections; run the exact isolated native selector"]
+async fn mesh04_local_identity_reverse_after_pending_pressure_retirement_reaches_registered_flow() {
+    let mut pair = NativePair::new()
+        .await
+        .expect("pending-pressure native pair setup");
