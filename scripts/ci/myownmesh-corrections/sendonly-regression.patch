+#[derive(Default, Debug)]
+struct IdentityObservation {
+    still_registered: bool,
+    video_native_associations: usize,
+    expected_native_associations: usize,
+}
+
+async fn association(peer: &NativePeer, flow: &OpenFlow) -> NativeResult<IdentityObservation> {
+    let identity = flow
+        .identity
+        .as_ref()
+        .ok_or("fixture expected inbound identity")?;
+    let mut result = IdentityObservation {
+        still_registered: peer.worker.session.realtime_tracks.classifies(identity),
+        ..Default::default()
+    };
+    for transceiver in peer.worker.session.pc.get_transceivers().await {
+        // Association only: tracks/kind are populated during negotiation and
+        // cannot establish receipt of even one RTP packet.
+        if transceiver.kind() != webrtc::rtp_transceiver::rtp_codec::RTPCodecType::Video {
+            continue;
+        }
+        let receiver = transceiver.receiver().await;
+        if receiver.tracks().await.is_empty() {
+            continue;
+        }
+        result.video_native_associations += 1;
+        let expected = {
+            let mut records = peer.worker.session.realtime_tracks.negotiated.lock();
+            records
+                .iter()
+                .find(|record| Arc::ptr_eq(&record.identity, identity))
+                .is_some_and(|record| record.transceiver.matches_native(&transceiver))
+        };
+        result.expected_native_associations += usize::from(expected);
+    }
+    Ok(result)
+}
+
+#[derive(Debug)]
+struct ReverseOutcome {
+    received: u8,
+    association: IdentityObservation,
+}
+
+async fn fresh_reverse(pair: &mut NativePair) -> NativeResult<ReverseOutcome> {
+    pair.connect().await?;
+    let video_in = pair
+        .offerer
+        .open_flow(b"identity-fresh-video", true, true)
+        .await?;
+    let video = pair
+        .answerer
+        .open_flow(b"identity-fresh-video", true, false)
+        .await?;
+    let audio_in = pair
+        .offerer
+        .open_flow(b"identity-fresh-audio", false, true)
+        .await?;
+    let audio = pair
+        .answerer
+        .open_flow(b"identity-fresh-audio", false, false)
+        .await?;
+    // Both intended native objects exist before the original offerer's offer.
+    // An early receive-only offer would test a distinct unbound-sender rival.
+    pair.negotiate().await?;
+    pair.answerer.await_bind(&video).await?;
+    pair.answerer.await_bind(&audio).await?;
+    pair.answerer.send(&video, true)?;
+    pair.answerer.send(&audio, false)?;
+    let received = pair
+        .receive(Side::Offerer, Some(&video_in), Some(&audio_in), &mut None)
+        .await?;
+    let association = tokio::time::timeout(STEP_BOUND, association(&pair.offerer, &video_in))
+        .await
+        .map_err(|_| "fixture fresh association observation bound")??;
+    Ok(ReverseOutcome {
+        received,
+        association,
+    })
+}
+
+async fn lifecycle_reverse(pair: &mut NativePair) -> NativeResult<ReverseOutcome> {
+    pair.connect().await?;
+    // Fixture orientation is explicit: A is the original SDP offerer and the
+    // initial media source. Actual1bc did not retain its A/B role orientation.
+    let video_in = pair
+        .answerer
+        .open_flow(b"identity-forward-video", true, true)
+        .await?;
+    let video = pair
+        .offerer
+        .open_flow(b"identity-forward-video", true, false)
+        .await?;
+    let audio_in = pair
+        .answerer
+        .open_flow(b"identity-forward-audio", false, true)
+        .await?;
+    let audio = pair
+        .offerer
+        .open_flow(b"identity-forward-audio", false, false)
+        .await?;
+    pair.negotiate().await?;
+    pair.offerer.await_bind(&video).await?;
+    pair.offerer.await_bind(&audio).await?;
+    pair.offerer.send(&video, true)?;
+    pair.offerer.send(&audio, false)?;
+    let mut audio_clock = None;
+    if pair
+        .receive(
+            Side::Answerer,
+            Some(&video_in),
+            Some(&audio_in),
+            &mut audio_clock,
+        )
+        .await?
+        != 3
+    {
+        return Err("fixture initial real forward video/audio control did not complete");
+    }
+
+    // This A outbound remove AND B inbound stop are the actual two retirement
+    // directions. A has never opened an inbound media flow before reverse.
+    pair.offerer.close_flow(&video).await?;
+    pair.answerer.close_flow(&video_in).await?;
+    pair.offerer.send(&audio, false)?;
+    if pair
+        .receive(Side::Answerer, None, Some(&audio_in), &mut audio_clock)
+        .await?
+        != 2
+    {
+        return Err("fixture actual audio did not survive video retirement");
+    }
+    drop(video);
+    drop(video_in);
+
+    let pressure_in = pair
+        .answerer
+        .open_flow(b"identity-pressure-video", true, true)
+        .await?;
+    let pressure = pair
+        .offerer
+        .open_flow(b"identity-pressure-video", true, false)
+        .await?;
+    pair.negotiate().await?;
+    pair.offerer.await_bind(&pressure).await?;
+    // The strict daemon pressure path rejects the oversized IPC prefix before
+    // it becomes RTP. This core control preserves native open/retire only;
+    // it neither fabricates that rejection nor writes a warmup media unit.
+    pair.offerer.close_flow(&pressure).await?;
+    pair.answerer.close_flow(&pressure_in).await?;
+    pair.offerer.send(&audio, false)?;
+    if pair
+        .receive(Side::Answerer, None, Some(&audio_in), &mut audio_clock)
+        .await?
+        != 2
+    {
+        return Err("fixture actual audio did not survive pressure-track retirement");
+    }
+    drop(pressure);
+    drop(pressure_in);
+    pair.offerer.close_flow(&audio).await?;
+    pair.answerer.close_flow(&audio_in).await?;
+    drop(audio);
+    drop(audio_in);
+
+    let reverse_in = pair
+        .offerer
+        .open_flow(b"identity-reverse-video", true, true)
+        .await?;
+    let reverse = pair
+        .answerer
+        .open_flow(b"identity-reverse-video", true, false)
+        .await?;
+    let reverse_audio_in = pair
+        .offerer
+        .open_flow(b"identity-reverse-audio", false, true)
+        .await?;
+    let reverse_audio = pair
+        .answerer
+        .open_flow(b"identity-reverse-audio", false, false)
+        .await?;
+    // No role flip and no completed receive-only transaction between either
+    // legitimate inbound open and its opposite outbound source construction.
+    pair.negotiate().await?;
+    pair.answerer.await_bind(&reverse).await?;
+    pair.answerer.await_bind(&reverse_audio).await?;
+    pair.answerer.send(&reverse, true)?;
+    pair.answerer.send(&reverse_audio, false)?;
+    let received = pair
+        .receive(
+            Side::Offerer,
+            Some(&reverse_in),
+            Some(&reverse_audio_in),
+            &mut None,
+        )
+        .await?;
+    if received & 2 == 0 {
+        return Err("fixture real reverse audio control did not complete");
+    }
+    let association = tokio::time::timeout(STEP_BOUND, association(&pair.offerer, &reverse_in))
+        .await
+        .map_err(|_| "fixture reverse association observation bound")??;
+    // Handles and both PCs remain owned at this observation. The associated
+    // native receiver's kind is not counted as RTP arrival; only a complete
+    // unchanged on_track/pump delivery sets a received bit.
+    Ok(ReverseOutcome {
+        received,
+        association,
+    })
+}
