+#[tokio::test(flavor = "current_thread")]
+#[ignore = "opens two native peer connections; run the exact isolated native selector"]
+async fn mesh04_local_identity_reverse_after_retirement_reaches_registered_flow() {
+    let mut pair = NativePair::new()
+        .await
+        .expect("lifecycle native pair setup");
+    let observed = lifecycle_reverse(&mut pair).await;
+    let cleanup = pair.cleanup().await;
+    cleanup.expect("lifecycle native pair cleanup must finish before assertions");
+    let observed = observed.expect("native forward/audio/retirement/reverse-bind controls");
+    println!("mesh04_local_identity lifecycle_controls_and_cleanup_passed {observed:?}");
+    assert!(observed.association.still_registered && observed.received == 3,
+        "bound reverse video must reach its still-owned local flow after completed retirements; {observed:?}");
+}
