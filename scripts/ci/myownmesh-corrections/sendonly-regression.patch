+#[tokio::test(flavor = "current_thread")]
+#[ignore = "opens two native peer connections; run the exact isolated native selector"]
+async fn mesh04_local_identity_fresh_reverse_reaches_registered_flow() {
+    let mut pair = NativePair::new().await.expect("fresh native pair setup");
+    let observed = fresh_reverse(&mut pair).await;
+    let cleanup = pair.cleanup().await;
+    cleanup.expect("fresh native pair cleanup must finish before assertions");
+    let observed = observed.expect("fresh native setup/bind/whole-unit controls");
+    println!("mesh04_local_identity fresh_setup_and_cleanup_passed {observed:?}");
+    assert!(
+        observed.association.still_registered && observed.received == 3,
+        "fresh native reverse must reach its locally registered video/audio flows; {observed:?}"
+    );
+}
