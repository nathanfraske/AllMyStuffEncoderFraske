+impl NativePeer {
+    async fn new(role: Role) -> NativeResult<Self> {
+        use crate::resource::{ResourceClaim, ResourceClass};
+        // Exact existing private paired policy grant, independently verified in
+        // the authoring receipt. This selects no new production budget/default.
+        let grant = ResourceClaim::try_from_entries([
+            (ResourceClass::AccountedMemoryBytes, 536_870_912),
+            (ResourceClass::QueuedBytes, 67_108_864),
+            (ResourceClass::SocketOrHandle, 512),
+            (ResourceClass::NativeTransportObject, 512),
+            (ResourceClass::WorkerOrTask, 1_024),
+            (ResourceClass::CallbackOrScheduledWork, 4_096),
+            (ResourceClass::StorageBytes, 268_435_456),
+            (ResourceClass::StorageObject, 4_096),
+            (ResourceClass::RelayOrProviderAllocation, 64),
+            (ResourceClass::ParsingOrCpuWork, 100_000_000),
+            (ResourceClass::OpaqueDependencyResidual, 536_870_912),
+        ])
+        .map_err(|_| "fixture resource claim")?;
+        let provider = FiniteResourceProvider::new(grant);
+        let owner = ConnectorResourceOwnerPort::new(
+            ResourceProviderPort::new(provider.clone()).map_err(|_| "fixture provider")?,
+        );
+        let scope = owner.issue_mesh_scope().map_err(|_| "fixture Mesh scope")?;
+        let baseline = provider.in_use();
+        let baseline_reservations = provider.active_reservations();
+        let baseline_scopes = provider.active_scopes();
+        let profile = WebRtcConnectorProfile::new(ConnectorCallbackPolicy::elastic_realtime())
+            .with_realtime_profile(
+                RealtimeProfile::new(vec![
+                    session_flow::RealtimeCodec {
+                        kind: WebRtcRtpKind::Video,
+                        payload_type: 96,
+                        mime: "video/H264".to_owned(),
+                        clock_rate: 90_000,
+                        channels: 0,
+                        fmtp:
+                            "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f"
+                                .to_owned(),
+                        framing: RealtimeFraming::AnnexB,
+                        rtcp_feedback: Vec::new(),
+                    },
+                    session_flow::RealtimeCodec {
+                        kind: WebRtcRtpKind::Audio,
+                        payload_type: 111,
+                        mime: "audio/opus".to_owned(),
+                        clock_rate: 48_000,
+                        channels: 2,
+                        fmtp: "minptime=10;useinbandfec=1".to_owned(),
+                        framing: RealtimeFraming::Whole,
+                        rtcp_feedback: Vec::new(),
+                    },
+                ])
+                .map_err(|_| "fixture codec profile")?,
+            )
+            .map_err(|_| "fixture realtime profile")?;
+        let process = ProcessResourceRoot::isolated();
+        let resource_scope = process
+            .mesh_runtime_scope()
+            .network_instance_scope()
+            .peer_connection_scope();
+        let transport = Transport::new()
+            .map_err(|_| "fixture transport")?
+            .with_connector_resource_scope_for_test(scope.clone(), profile)
+            .map_err(|_| "fixture media installation")?;
+        let opened = tokio::time::timeout(
+            CONNECT_BOUND,
+            transport.open_connector_peer(role, &[], &[], resource_scope),
+        )
+        .await;
+        drop(transport);
+        let (worker, events) = match opened {
+            Ok(Ok(opened)) => opened,
+            failed => {
+                // The original constructor's partial-native custodian owns any
+                // unfinished close. Keep its resource owner alive and observe
+                // that completion even when setup failed or was cancelled.
+                let settled = tokio::time::timeout(STEP_BOUND, async {
+                    loop {
+                        let report = owner.report();
+                        if report.active_candidates == 0
+                            && report.failed_cleanup_candidates == 0
+                            && report.cleanup.queued_jobs == 0
+                            && report.cleanup.active_jobs == 0
+                            && provider.in_use() == baseline
+                            && provider.active_reservations() == baseline_reservations
+                            && provider.active_scopes() == baseline_scopes
+                        {
+                            break;
+                        }
+                        tokio::task::yield_now().await;
+                    }
+                })
+                .await
+                .is_ok();
+                drop(scope);
+                drop(owner);
+                if !settled
+                    || provider.in_use() != ResourceClaim::ZERO
+                    || provider.active_reservations() != 0
+                    || provider.active_scopes() != 0
+                {
+                    return Err("fixture partial-construction cleanup");
+                }
+                return Err(if failed.is_err() {
+                    "fixture native construction bound"
+                } else {
+                    "fixture native construction"
+                });
+            }
+        };
+        let binding = FlowFixtureSession {
+            incarnation: Arc::clone(worker.ownership.incarnation.generic()),
+        };
+        let flows = worker.new_session_flows();
+        Ok(Self {
+            worker,
+            events,
+            flows,
+            binding,
+            names: Vec::new(),
+            authentication: None,
+            open: false,
+            provider,
+            owner,
+            scope,
+            baseline,
+            baseline_reservations,
+            baseline_scopes,
+        })
+    }
+
+    fn encoding(video: bool) -> NativeResult<RealtimeEncoding> {
+        let (kind, mime, clock, channels) = if video {
+            (WebRtcRtpKind::Video, "video/H264", 90_000, 0)
+        } else {
+            (WebRtcRtpKind::Audio, "audio/opus", 48_000, 2)
+        };
+        RealtimeEncoding::new(kind, mime, clock, channels).ok_or("fixture encoding")
+    }
+
+    async fn open_flow(
+        &mut self,
+        label: &'static [u8],
+        video: bool,
+        inbound: bool,
+    ) -> NativeResult<OpenFlow> {
+        let encoding = Self::encoding(video)?;
+        let name = self
+            .flows
+            .open(
+                &self.binding,
+                self.worker.live_connector_incarnation(),
+                RealtimeFlowSpec {
+                    name: RealtimeFlowName::new(label.to_vec()).ok_or("fixture flow name")?,
+                    direction: if inbound {
+                        RealtimeDirection::Inbound
+                    } else {
+                        RealtimeDirection::Outbound
+                    },
+                    encoding: encoding.clone(),
+                },
+            )
+            .map_err(|_| "fixture logical flow open")?;
+        self.names.push(name.clone());
+        if inbound {
+            let identity = self
+                .worker
+                .mint_inbound_realtime_identity()
+                .map_err(|_| "fixture identity")?;
+            let retirement = self
+                .worker
+                .inbound_realtime_retirement(Arc::clone(&identity))
+                .map_err(|_| "fixture retirement reservation")?;
+            self.flows
+                .bind_inbound(
+                    &self.binding,
+                    self.worker.live_connector_incarnation(),
+                    &name,
+                    Arc::clone(&identity),
+                    retirement,
+                )
+                .map_err(|_| "fixture registered binding")?;
+            tokio::time::timeout(
+                STEP_BOUND,
+                self.worker
+                    .open_inbound_realtime_transceiver(&identity, &encoding),
+            )
+            .await
+            .map_err(|_| "fixture inbound construction bound")?
+            .map_err(|_| "fixture native inbound negotiation")?;
+            if !self.worker.session.realtime_tracks.classifies(&identity) {
+                return Err("fixture native inbound identity was not recorded");
+            }
+            Ok(OpenFlow {
+                name,
+                identity: Some(identity),
+                native: None,
+                sender: None,
+            })
+        } else {
+            let track = tokio::time::timeout(
+                STEP_BOUND,
+                self.worker.open_outbound_realtime_track(&encoding),
+            )
+            .await
+            .map_err(|_| "fixture outbound construction bound")?
+            .map_err(|_| "fixture native outbound negotiation")?;
+            let native = Arc::clone(&track.track);
+            let sender = Arc::clone(&track.sender);
+            if let Err((_error, track)) = self.flows.attach_outbound(
+                &self.binding,
+                self.worker.live_connector_incarnation(),
+                &name,
+                track,
+            ) {
+                tokio::time::timeout(STEP_BOUND, self.worker.close_outbound_realtime_track(track))
+                    .await
+                    .map_err(|_| "fixture refused attachment cleanup bound")?;
+                return Err("fixture outbound attachment");
+            }
+            Ok(OpenFlow {
+                name,
+                identity: None,
+                native: Some(native),
+                sender: Some(sender),
+            })
+        }
+    }
+
+    async fn await_bind(&self, flow: &OpenFlow) -> NativeResult<()> {
+        let native = flow.native.as_ref().ok_or("fixture sender handle")?;
+        tokio::time::timeout(STEP_BOUND, native.wait_for_first_bind())
+            .await
+            .map_err(|_| "fixture sender stayed unbound; not the selected receiver negative")
+    }
+
+    fn send(&mut self, flow: &OpenFlow, video: bool) -> NativeResult<()> {
+        self.flows
+            .send(
+                &self.binding,
+                self.worker.live_connector_incarnation(),
+                &flow.name,
+                RealtimeSendUnit {
+                    data: Bytes::from_static(if video { VIDEO } else { AUDIO }),
+                    pace: if video {
+                        Duration::from_millis(40)
+                    } else {
+                        Duration::from_millis(20)
+                    },
+                },
+            )
+            .map_err(|_| "fixture real pump queue send")
+    }
+
+    async fn close_name(&mut self, name: &RealtimeFlowName) -> NativeResult<()> {
+        let remains = self
+            .flows
+            .close(
+                &self.binding,
+                self.worker.live_connector_incarnation(),
+                name,
+            )
+            .map_err(|_| "fixture flow close")?;
+        self.names.retain(|held| held.as_bytes() != name.as_bytes());
+        match remains {
+            RealtimeFlowRemains::Inbound(mut retirement) => {
+                let identity = retirement.take_for_explicit_close();
+                self.worker
+                    .close_inbound_realtime_transceiver(&identity)
+                    .await;
+                drop(retirement);
+                if self.worker.session.realtime_tracks.classifies(&identity) {
+                    return Err("fixture inbound native stop did not complete");
+                }
+            }
+            RealtimeFlowRemains::Outbound(retired) => {
+                retired
+                    .await
+                    .map_err(|_| "fixture actual pump retirement ACK dropped")?;
+            }
+            RealtimeFlowRemains::None => {}
+        }
+        Ok(())
+    }
+
+    async fn close_flow(&mut self, flow: &OpenFlow) -> NativeResult<()> {
+        tokio::time::timeout(STEP_BOUND, async {
+            self.close_name(&flow.name).await?;
+            if let Some(sender) = flow.sender.as_ref() {
+                if sender.track().await.is_some() {
+                    return Err("fixture native sender was not detached before ACK");
+                }
+            }
+            Ok(())
+        })
+        .await
+        .map_err(|_| "fixture flow retirement bound")?
+    }
+
+    async fn cleanup(mut self) -> NativeResult<()> {
+        let mut clean = true;
+        while let Some(name) = self.names.pop() {
+            clean &= matches!(
+                tokio::time::timeout(STEP_BOUND, self.close_name(&name)).await,
+                Ok(Ok(()))
+            );
+        }
+        let weak_native = Arc::downgrade(&self.worker.session.pc);
+        clean &= matches!(
+            tokio::time::timeout(STEP_BOUND, self.worker.retire_and_close()).await,
+            Ok(Ok(()))
+        );
+        clean &= self.flows.is_quiescent();
+        let Self {
+            worker,
+            events,
+            flows,
+            binding,
+            authentication,
+            provider,
+            owner,
+            scope,
+            baseline,
+            baseline_reservations,
+            baseline_scopes,
+            ..
+        } = self;
+        drop(authentication);
+        drop(flows);
+        drop(binding);
+        drop(events);
+        drop(worker);
+        let settled = tokio::time::timeout(STEP_BOUND, async {
+            loop {
+                let report = owner.report();
+                if report.active_candidates == 0
+                    && report.failed_cleanup_candidates == 0
+                    && report.cleanup.queued_jobs == 0
+                    && report.cleanup.active_jobs == 0
+                    && provider.in_use() == baseline
+                    && provider.active_reservations() == baseline_reservations
+                    && provider.active_scopes() == baseline_scopes
+                    && weak_native.upgrade().is_none()
+                {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .is_ok();
+        drop(scope);
+        drop(owner);
+        if !clean || !settled {
+            return Err("fixture owned native/task/socket/resource cleanup");
+        }
+        if provider.in_use() != crate::resource::ResourceClaim::ZERO
+            || provider.active_reservations() != 0
+            || provider.active_scopes() != 0
+        {
+            return Err("fixture provider did not return to zero after owner drop");
+        }
+        Ok(())
+    }
+}
