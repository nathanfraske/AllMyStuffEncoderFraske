+struct NativePeer {
+    worker: WebRtcConnectorWorker,
+    events: WebRtcConnectorEventReceiver,
+    flows: SessionRealtimeFlows,
+    binding: FlowFixtureSession,
+    names: Vec<RealtimeFlowName>,
+    authentication: Option<crate::endpoint_auth::EndpointAuthTask>,
+    open: bool,
+    provider: FiniteResourceProvider,
+    owner: ConnectorResourceOwnerPort,
+    scope: MeshConnectorResourceScope,
+    baseline: crate::resource::ResourceClaim,
+    baseline_reservations: usize,
+    baseline_scopes: usize,
+}
