+struct NativePair {
+    offerer: NativePeer,
+    answerer: NativePeer,
+}
+
+impl NativePair {
+    async fn new() -> NativeResult<Self> {
+        let offerer = NativePeer::new(Role::Offerer).await?;
+        let answerer = match NativePeer::new(Role::Answerer).await {
+            Ok(peer) => peer,
+            Err(error) => {
+                offerer.cleanup().await?;
+                return Err(error);
+            }
+        };
+        Ok(Self { offerer, answerer })
+    }
+
+    fn peer(&mut self, side: Side) -> &mut NativePeer {
+        match side {
+            Side::Offerer => &mut self.offerer,
+            Side::Answerer => &mut self.answerer,
+        }
+    }
+
+    async fn negotiate(&mut self) -> NativeResult<()> {
+        // Fixed roles for every transaction; the original answerer never
+        // introduces a new offer/m-line through an artificial role flip.
+        tokio::time::timeout(CONNECT_BOUND, async {
+            let offer = self
+                .offerer
+                .worker
+                .create_offer()
+                .await
+                .map_err(|_| "fixture offer")?;
+            self.answerer
+                .worker
+                .session
+                .set_remote_description(offer)
+                .await
+                .map_err(|_| "fixture remote offer")?;
+            let answer = self
+                .answerer
+                .worker
+                .create_answer()
+                .await
+                .map_err(|_| "fixture answer")?;
+            self.offerer
+                .worker
+                .session
+                .set_remote_description(answer)
+                .await
+                .map_err(|_| "fixture remote answer")?;
+            Ok(())
+        })
+        .await
+        .map_err(|_| "fixture offer/answer bound")?
+    }
+
+    async fn next_unit(&mut self) -> NativeResult<Option<UnitEvent>> {
+        let (side, raw) = tokio::select! {
+            event = self.offerer.events.recv() => (Side::Offerer, event),
+            event = self.answerer.events.recv() => (Side::Answerer, event),
+        };
+        let raw = raw.ok_or("fixture native event stream ended")?;
+        let accepted = self
+            .peer(side)
+            .worker
+            .accept_event(raw)
+            .ok_or("fixture native owner rejected event")?;
+        let (event, resources) = accepted.into_parts();
+        match event {
+            TransportEvent::LocalIceCandidate(Some(candidate)) => {
+                let opposite = if side == Side::Offerer {
+                    Side::Answerer
+                } else {
+                    Side::Offerer
+                };
+                // Existing loopback signaling seam; production on_track and
+                // flow admission are unchanged. Candidate policy is not this test.
+                self.peer(opposite)
+                    .worker
+                    .session
+                    .add_ice_candidate(candidate)
+                    .await
+                    .map_err(|_| "fixture native candidate application")?;
+                Ok(None)
+            }
+            TransportEvent::DataChannelOpen => {
+                let peer = self.peer(side);
+                match peer.worker.confirm_data_channel_open() {
+                    DataChannelOpenOwnership::Connected(handoff) => {
+                        peer.authentication = Some(task_from_handoff(handoff))
+                    }
+                    DataChannelOpenOwnership::AlreadyConnected => {}
+                    DataChannelOpenOwnership::Rejected => {
+                        return Err("fixture native open ownership")
+                    }
+                }
+                peer.events.commit_data_channel_open();
+                peer.open = true;
+                Ok(None)
+            }
+            TransportEvent::RealtimeUnit(delivery) => Ok(Some(UnitEvent {
+                side,
+                delivery,
+                _resources: resources,
+            })),
+            TransportEvent::DataChannelClosed => Err("fixture native channel closed early"),
+            // Renegotiation events are serviced by the explicit fixed-role
+            // transactions above. No realtime unit is discarded by this arm.
+            _ => Ok(None),
+        }
+    }
+
+    async fn connect(&mut self) -> NativeResult<()> {
+        self.negotiate().await?;
+        tokio::time::timeout(CONNECT_BOUND, async {
+            while !self.offerer.open || !self.answerer.open {
+                if self.next_unit().await?.is_some() {
+                    return Err("fixture unsolicited media before flow open");
+                }
+            }
+            Ok(())
+        })
+        .await
+        .map_err(|_| "fixture genuine native open bound")?
+    }
+
+    async fn receive(
+        &mut self,
+        side: Side,
+        video: Option<&OpenFlow>,
+        audio: Option<&OpenFlow>,
+        audio_clock: &mut Option<u32>,
+    ) -> NativeResult<u8> {
+        let wanted = u8::from(video.is_some()) | (u8::from(audio.is_some()) << 1);
+        let mut seen = 0u8;
+        let deadline = tokio::time::Instant::now() + STEP_BOUND;
+        while seen != wanted {
+            let event = match tokio::time::timeout_at(deadline, self.next_unit()).await {
+                Err(_) => return Ok(seen),
+                Ok(event) => event?,
+            };
+            let Some(event) = event else { continue };
+            if event.side != side || event.delivery.payload.is_none() {
+                return Err("fixture wrong recipient or unaccounted native delivery");
+            }
+            let label = event.delivery.label.name().as_bytes();
+            let (bit, bytes) = if video.is_some_and(|flow| flow.name.as_bytes() == label) {
+                (1u8, VIDEO_EXPECTED)
+            } else if audio.is_some_and(|flow| flow.name.as_bytes() == label) {
+                (2u8, AUDIO)
+            } else {
+                return Err("fixture native delivery used an unexpected local flow");
+            };
+            if seen & bit != 0 || event.delivery.unit.data.as_ref() != bytes {
+                return Err("fixture duplicate or nonexact first native unit");
+            }
+            if bit == 1 && !event.delivery.unit.marker {
+                return Err("fixture valid first video AU lost its entry-point significance");
+            }
+            if bit == 2 {
+                let timestamp = event.delivery.unit.timestamp;
+                if audio_clock.is_some_and(|previous| timestamp.wrapping_sub(previous) != 960) {
+                    return Err("fixture surviving audio clock step is not exact");
+                }
+                *audio_clock = Some(timestamp);
+            }
+            seen |= bit;
+        }
+        Ok(seen)
+    }
+
+    async fn cleanup(self) -> NativeResult<()> {
+        let (a, b) = tokio::join!(self.offerer.cleanup(), self.answerer.cleanup());
+        a?;
+        b
+    }
+}
