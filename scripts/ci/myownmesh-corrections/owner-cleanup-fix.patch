+/// Custody of the exact Events registration across errors and task cancellation.
+///
+/// Normal completion takes the removed record through the awaited release path.
+/// If the task is dropped first, revoke only this handle and use the existing
+/// synchronous flow cleanup and route-join custodian. No cleanup task is spawned.
+struct EventsOwner<'a> {
+    clients: &'a crate::ipc::ClientRegistry,
+    client: &'a myownmesh_core::FundedArc<crate::ipc::ClientHandle>,
+}
+
+impl<'a> EventsOwner<'a> {
+    fn new(
+        clients: &'a crate::ipc::ClientRegistry,
+        client: &'a myownmesh_core::FundedArc<crate::ipc::ClientHandle>,
+    ) -> Self {
+        Self { clients, client }
+    }
+
+    fn unregister(&self) -> Option<crate::ipc::UnregisteredClient> {
+        self.clients.unregister_exact(self.client)
+    }
+}
+
+impl Drop for EventsOwner<'_> {
+    fn drop(&mut self) {
+        if let Some(removed) = self.unregister() {
+            // Other command tasks can still hold this client handle. Draining
+            // now makes revocation independent of when those clones are dropped.
+            drop(removed.handle.drain_realtime_flows());
+            drop(removed);
+        }
+    }
+}
