+    /// Whether this exact handle is still admitted by this registry.
+    ///
+    /// A numeric id alone is insufficient: another registry can issue the same
+    /// number, and a stale handoff must never act on a different owner.
+    pub(crate) fn is_current_owner(&self, owner: &FundedArc<ClientHandle>) -> bool {
+        let tables = self.inner.tables.lock();
+        admitting(&tables).is_ok()
+            && tables.clients.get(&owner.id).is_some_and(|current| {
+                std::ptr::eq(&**current, &**owner) && owner.connected.load(Ordering::Acquire)
+            })
+    }
