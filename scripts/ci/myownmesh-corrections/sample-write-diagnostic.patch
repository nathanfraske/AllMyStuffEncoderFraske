+/// Only the two owned reservations cross into the observed task. Neither
+/// reservation retains a flow, queue, session, track or worker.
+struct RealtimeSampleWriteDiagnosticFunding {
+    _future: crate::resource::ResourceLease,
+    _task: crate::resource::ResourceLease,
+}
+
+/// The concrete boxed future is freed before either of its funding leases.
+/// Tokio's task header stays an opaque dependency residual; its stored wrapper
+/// and the boxed future are independently measured from their actual types.
+struct RealtimeSampleWriteDiagnosticTask<F> {
+    future: Option<Pin<Box<F>>>,
+    _funding: RealtimeSampleWriteDiagnosticFunding,
+}
+
+impl<F: Future<Output = ()>> Future for RealtimeSampleWriteDiagnosticTask<F> {
+    type Output = ();
+
+    fn poll(
+        self: Pin<&mut Self>,
+        context: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Self::Output> {
+        self.get_mut()
+            .future
+            .as_mut()
+            .expect("the observed future stays owned until task drop")
+            .as_mut()
+            .poll(context)
+    }
+}
+
+impl<F> Drop for RealtimeSampleWriteDiagnosticTask<F> {
+    fn drop(&mut self) {
+        // Includes cancellation: destroy and deallocate the boxed future first.
+        drop(self.future.take());
+    }
+}
+
+fn reserve_sample_write_diagnostic(
+    port: &realtime::RealtimeFlowPort,
+) -> Option<RealtimeSampleWriteDiagnosticFunding> {
+    fn reserve<C, F>(
+        port: &realtime::RealtimeFlowPort,
+        _constructor: C,
+    ) -> Option<RealtimeSampleWriteDiagnosticFunding>
+    where
+        C: FnOnce(
+            session_flow::RealtimeOutboundPump,
+            RealtimeOutboundTrack,
+            tokio::sync::oneshot::Sender<()>,
+        ) -> F,
+        F: Future<Output = ()> + Send + 'static,
+    {
+        // C is never invoked here. F includes every captured owner, the
+        // observation, and the complete nested vendor write futures. No probe
+        // future is made, polled or dropped with the real pump/track.
+        let future = port.reserve_boxed_checked::<F>().ok()?;
+        let task = port
+            .reserve_boxed_checked::<RealtimeSampleWriteDiagnosticTask<F>>()
+            .ok()?;
+        // Each existing boxed claim charges size_of::<T>() plus one allocation
+        // residual; the existing provider adds its own reservation bookkeeping.
+        Some(RealtimeSampleWriteDiagnosticFunding {
+            _future: future,
+            _task: task,
+        })
+    }
+
+    if !tracing::enabled!(target: "mesh_first_unit", tracing::Level::DEBUG) {
+        return None;
+    }
+    reserve(port, observed_outbound_realtime_pump)
+}
+
+fn spawn_observed_outbound_realtime_pump(
+    pump: session_flow::RealtimeOutboundPump,
+    track: RealtimeOutboundTrack,
+    retired: tokio::sync::oneshot::Sender<()>,
+    funding: RealtimeSampleWriteDiagnosticFunding,
+) {
+    let close_owner = Arc::clone(&track.close_owner);
+    let task = tokio::spawn(RealtimeSampleWriteDiagnosticTask {
+        future: Some(Box::pin(observed_outbound_realtime_pump(
+            pump, track, retired,
+        ))),
+        _funding: funding,
+    });
+    close_owner.retain_transport_task(task);
+}
+
+// Separate coroutine: failed optional admission uses the byte-identical
