+/// Nonauthorizing storage for a privately selected sample-write observation.
+///
+/// The caller owns funding for this state and the complete observed future.
+/// This carries no identifiers, payload, authority or resource-provider handle.
+#[doc(hidden)]
+#[derive(Default)]
+pub struct SampleWriteObservation {
+    outcomes: u8,
+}
+
+impl SampleWriteObservation {
+    const ALL_PAUSED: u8 = 1 << 0;
+    const ZERO_PACKETS: u8 = 1 << 1;
+    const WRITE_ZERO: u8 = 1 << 2;
+    const WRITE_POSITIVE: u8 = 1 << 3;
+    const WRITE_ERROR: u8 = 1 << 4;
+    const PACKETIZATION_ERROR: u8 = 1 << 5;
+
+    // Called only after the original write scope, including its guard, ended.
+    // Entry is a completed-call fact; cancellation can leave no record.
+    fn emit(&self) {
+        log::debug!(
+            target: "mesh_first_unit",
+            "MESH04_SAMPLE_WRITE entry=true all_paused_true_no_packetization={} zero_packets={} native_write_zero={} native_write_positive={} native_error={} packetization_error={}",
+            self.outcomes & Self::ALL_PAUSED != 0,
+            self.outcomes & Self::ZERO_PACKETS != 0,
+            self.outcomes & Self::WRITE_ZERO != 0,
+            self.outcomes & Self::WRITE_POSITIVE != 0,
+            self.outcomes & Self::WRITE_ERROR != 0,
+            self.outcomes & Self::PACKETIZATION_ERROR != 0,
+        );
+    }
 }
 
