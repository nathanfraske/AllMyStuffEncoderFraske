+    async {
+        // Keep accepted units and their leases in the existing queue while
+        // negotiation binds the native track. Closing the exact owner or
+        // retiring the connector cancels this wait, then the common tail
+        // below still removes the native sender and completes retirement.
+        let bound = tokio::select! {
+            biased;
+            () = pump.closed() => false,
+            ready = await_until_connector_retirement(
+                incarnation.subscribe_retirement(),
+                native.wait_for_first_bind(),
+            ) => ready.is_some(),
+        };
+        if !bound {
+            return;
+        }
